    %% 규칙 상자를 맨 위에 둔다
    RULE ~~~ REQ
    W_LAW --> W_Q
    W_PARTY --> W_Q
    W_TEST --> W_Q
    W_Q -- "근거가 바뀌었거나<br/>결론이 틀림" --> W_STOP
    W_Q -- "이미 맡은 일과<br/>새 충돌 후보" --> H5
    W_Q -- "기준이나 프로그램을<br/>고쳐야 함" --> W_NEW
    W_Q -- "시험 결과가 나빠짐" --> W_NARROW
    W_NEW -- "고친 것을 적용" --> W_CHANGE
    W_STOP -- "바뀐 근거부터<br/>다시 찾음" --> SEARCH
    REQ --> INTAKE
    INTAKE --> CONFLICT
    CONFLICT -- "충돌 후보 없음" --> READ
    CONFLICT -- "충돌 후보 있음" --> H1
    H1 -- "맡지 않음" --> DECLINE
    H1 -- "맡아도 됨" --> READ
    READ --> HIDDEN
    HIDDEN --> RANGE
    RANGE --> RANGE_Q
    RANGE_Q -- "예" --> QUAR
    RANGE_Q -- "아니오" --> OUT
    QUAR --> INDEX
    INDEX -- "새 충돌 후보 없음" --> SEARCH
    INDEX -- "새 충돌 후보 있음" --> H5
    H5 -- "그만둠" --> QUIT
    H5 -- "맡아도 됨" --> SEARCH
    SEARCH --> SOURCE
    SOURCE --> ENOUGH
